# Neon Postgres (optional locally: in-memory pre-seeded demo mode runs automatically when unset)
DATABASE_URL=

# Vercel AI Gateway (optional locally: deterministic NLP filter fallback runs automatically when unset)
AI_GATEWAY_API_KEY=
PAACO_MODEL=anthropic/claude-haiku-4.5

# Better Auth (required when DATABASE_URL is configured for /dashboard sign-in)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public testnet RPC endpoints for on-chain settlement reconciliation
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional alert webhook (Slack/Discord/HTTP) triggered by Workflow on Ghost Payments & Loop Burns
PAACO_ALERT_WEBHOOK_URL=

# Optional comma-separated read-only / ingest demo key override
PAACO_DEMO_API_KEY=paaco_demo_readonly_key
