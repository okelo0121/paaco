{
  "name": "paaco",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @paaco/web db:generate",
    "db:push": "pnpm --filter @paaco/web db:push",
    "db:seed": "pnpm --filter @paaco/web db:seed"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.11.13",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  }
}
